# Copy to .env to override defaults. All values are optional.
HOST=127.0.0.1
PORT=3000
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:3b
OLLAMA_KEEP_ALIVE=5m
OLLAMA_NUM_CTX=4096
DB_PATH=data/ai-office.db

# Read-only inbox for the Email agent (optional). Gmail/Outlook need an app password.
# Gmail: IMAP_HOST=imap.gmail.com  |  Outlook: IMAP_HOST=outlook.office365.com
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
